# Convco / conventional commits config (see https://convco.github.io/configuration/)
# Used by: PR title check (convco check) only. Changelog is generated by python-semantic-release.
#
# Customize this after generation if your team wants stricter scopes.

types:
  - type: feat
  - type: fix
  - type: docs
  - type: refactor
  - type: perf
  - type: test
  - type: build
  - type: ci
  - type: chore

# The ? makes scope optional, so both "feat: add X" and "feat(api): add X" pass.
scopeRegex: "^([a-z0-9._/-]+)?$"

lineLength: 100
